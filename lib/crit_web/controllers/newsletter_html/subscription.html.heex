<Layouts.site_page flash={@flash} current_scope={@current_scope} page_path="/newsletter">
  <Site.wrap class="max-w-[calc(36rem+7rem)] py-24 max-md:py-14">
    <h1 class="text-[clamp(30px,3.6vw,48px)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance">
      {if @action == :confirm,
        do: "Confirm your subscription",
        else: "Unsubscribe from Crit updates"}
    </h1>
    <p class="mt-4 text-lg text-(--crit-fg-secondary)">
      {if @action == :confirm,
        do:
          "Occasional updates from Crit, straight to your inbox. Unsubscribe whenever you like.",
        else: "You'll stop receiving the Crit newsletter."}
    </p>
    <.form
      for={%{}}
      id="newsletter-confirmation"
      action={
        if @action == :confirm,
          do: ~p"/newsletter/confirm/#{@token}",
          else: ~p"/newsletter/unsubscribe/#{@token}"
      }
      class="mt-6"
    >
      <button
        type="submit"
        class={[CritWeb.SiteComponents.btn_class("primary"), "cursor-pointer"]}
      >
        {if @action == :confirm, do: "Confirm subscription", else: "Unsubscribe"}
      </button>
    </.form>
  </Site.wrap>
</Layouts.site_page>
