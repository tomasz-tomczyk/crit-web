<div class="min-h-screen bg-(--crit-bg-page) text-(--crit-fg-primary) font-sans antialiased">
  <Layouts.site_header current_scope={@current_scope} />
  <main class="max-w-lg mx-auto px-6 py-20">
    <h1 class="text-2xl font-bold">
      {if @action == :confirm,
        do: "Confirm your subscription",
        else: "Unsubscribe from Crit updates"}
    </h1>
    <p class="mt-3 text-(--crit-fg-secondary)">
      {if @action == :confirm,
        do:
          "Occasional updates from Crit, straight to your inbox. Unsubscribe whenever you like.",
        else: "You'll stop receiving the Crit newsletter."}
    </p>
    <.form
      for={%{}}
      id="newsletter-confirmation"
      action={
        if @action == :confirm,
          do: ~p"/newsletter/confirm/#{@token}",
          else: ~p"/newsletter/unsubscribe/#{@token}"
      }
      class="mt-6"
    >
      <button
        type="submit"
        class="min-h-11 px-4 py-2 rounded-md border border-(--crit-border) bg-(--crit-bg-elevated) hover:border-(--crit-fg-muted) cursor-pointer"
      >
        {if @action == :confirm, do: "Confirm subscription", else: "Unsubscribe"}
      </button>
    </.form>
  </main>
  <Layouts.site_footer page_path="/newsletter" />
</div>
