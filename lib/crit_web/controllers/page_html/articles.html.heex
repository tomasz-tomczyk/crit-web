<Layouts.site_page
  flash={@flash}
  current_scope={@current_scope}
  current_page={:articles}
  page_path={@conn.request_path}
>
  <Site.page_head eyebrow="Writing">
    <:title>Articles<Site.dot /></:title>
    <:lede>
      Notes on reviewing agent output, tightening feedback loops, and shipping with more control.
    </:lede>
  </Site.page_head>

  <section class="pb-24 max-md:pb-18">
    <Site.wrap>
      <article :if={@featured} class="mb-16 max-md:mb-12">
        <.article_card article={@featured} variant="featured" />
      </article>

      <div class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1">
        <.article_card :for={article <- @rest} article={article} variant="default" />
      </div>
    </Site.wrap>
  </section>
</Layouts.site_page>
