<Layouts.site_page
  flash={@flash}
  current_scope={@current_scope}
  current_page={:features}
  page_path={@conn.request_path}
>
  <Site.page_head eyebrow="Features">
    <:title>Built for the feedback loop<Site.dot /></:title>
    <:lede>
      Inline comments on plans and code diffs. A structured prompt back to your agent.
      Multi-round iteration until the output is right. Everything below is built for that loop.
    </:lede>
  </Site.page_head>

  <section aria-label="Features" class="pb-24 max-md:pb-18">
    <Site.wrap>
      <Site.cards>
        <li :for={slug <- @feature_order} class="flex">
          <Site.card href={~p"/features/#{slug}"} class="flex-1">
            <Site.card_title tag="h2" class="group-hover:text-(--crit-brand)">
              {@features[slug].title}
            </Site.card_title>
            <Site.card_text>{@features[slug].tagline}</Site.card_text>
            <span class="mt-auto pt-3 text-sm font-semibold text-(--crit-brand)">
              Learn more <span aria-hidden="true">&rarr;</span>
            </span>
          </Site.card>
        </li>
      </Site.cards>
    </Site.wrap>
  </section>

  <Site.section id="modes" panel>
    <Site.section_head eyebrow="Five review modes">
      Pick the surface for what your agent made<Site.dot />
      <:text>
        Plans, diffs, running apps and HTML files each open in a review mode built for them.
      </:text>
    </Site.section_head>
    <Site.cards>
      <li :for={mode <- CritWeb.PageHTML.modes()} class="flex">
        <Site.card href={"/modes/#{mode.slug}"} class="flex-1 bg-(--crit-bg-page)">
          <Site.eyebrow class="mb-0">{mode.cmd}</Site.eyebrow>
          <Site.card_title class="group-hover:text-(--crit-brand)">{mode.label}</Site.card_title>
          <Site.card_text>{mode.blurb}</Site.card_text>
          <span class="mt-auto pt-3 text-sm font-semibold text-(--crit-brand)">
            {mode.nav_label} <span aria-hidden="true">&rarr;</span>
          </span>
        </Site.card>
      </li>
    </Site.cards>
  </Site.section>
</Layouts.site_page>
