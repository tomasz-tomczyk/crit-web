<Layouts.site_page
  flash={@flash}
  current_scope={@current_scope}
  current_page={:articles}
  page_path={@conn.request_path}
>
  <article>
    <Site.page_head
      class="mx-auto max-w-[calc(64ch+7rem)] !pb-10"
      title_class="!text-[clamp(30px,3.6vw,48px)] !leading-[1.08] !max-w-none"
      tag="div"
    >
      <:title>{@article.title}</:title>
      <:lede>{@article.excerpt}</:lede>
      <p class="mt-6 font-mono text-xs text-(--crit-fg-muted)">
        <time datetime={Crit.Articles.format_date_iso(@article.published_at)}>
          {Crit.Articles.format_date(@article.published_at)}
        </time>
        · {@article.author} · {@article.read_time}
      </p>
    </Site.page_head>

    <Site.wrap class="max-w-[calc(64ch+7rem)] pb-24 max-md:pb-18">
      <Site.media class="mb-14 max-md:mb-10">
        <img
          src={@article.hero_image}
          alt=""
          class="block w-full h-auto"
          width="1200"
          height="675"
          loading="eager"
          decoding="async"
        />
      </Site.media>

      <div class="article-body text-(--crit-fg-secondary)">
        {@article.body_html}
      </div>

      <footer class="mt-14 pt-8 border-t border-(--crit-border)">
        <Site.link_arrow href={~p"/articles"}>All articles</Site.link_arrow>
      </footer>
    </Site.wrap>
  </article>
</Layouts.site_page>
