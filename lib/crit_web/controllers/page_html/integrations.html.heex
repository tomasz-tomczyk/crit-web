<Layouts.site_page
  flash={@flash}
  current_scope={@current_scope}
  current_page={:integrations}
  page_path={@conn.request_path}
>
  <Site.page_head eyebrow="Integrations">
    <:title>Agent integrations for Crit<Site.dot /></:title>
    <:lede>
      Crit writes a structured review file. Any agent that can read a file and run a command can use it. Pick yours for the setup steps.
    </:lede>
  </Site.page_head>

  <section class="pb-24 max-md:pb-18">
    <Site.wrap>
      <Site.cards>
        <li :for={tool <- Crit.Integrations.tools()} class="flex">
          <Site.card href={~p"/integrations/#{tool.id}"} class="flex-1 py-8">
            <div class="flex items-center gap-4">
              <div class="shrink-0 size-12 flex items-center justify-center rounded-md bg-(--crit-bg-page) border border-(--crit-border) overflow-hidden">
                <%= case tool.logo do %>
                  <% nil -> %>
                    <span class="font-mono font-bold text-(--crit-fg-secondary)">
                      {String.first(tool.name)}
                    </span>
                  <% logo -> %>
                    <img
                      src={logo.dark}
                      alt={"#{tool.name} logo"}
                      class="logo-dark size-8 object-contain"
                      loading="lazy"
                    />
                    <img
                      src={logo.light}
                      alt={"#{tool.name} logo"}
                      class="logo-light size-8 object-contain"
                      loading="lazy"
                    />
                <% end %>
              </div>
              <Site.card_title tag="h2" class="group-hover:text-(--crit-brand)">
                {tool.name}
              </Site.card_title>
            </div>
            <Site.card_text>{tool.tagline}</Site.card_text>
            <code
              :if={cmd = CritWeb.PageHTML.agent_install_cmd(tool.id)}
              class="mt-auto font-mono text-xs leading-relaxed text-(--crit-fg-secondary) bg-(--crit-bg-page) border border-(--crit-border) rounded-md px-3 py-2 [overflow-wrap:anywhere]"
            >
              <span class="text-(--crit-brand) mr-[0.6ch]">$</span>{cmd}
            </code>
          </Site.card>
        </li>
        <li class="flex">
          <Site.card
            href={~p"/integrations/build-your-own"}
            class="flex-1 py-8 border-dashed border-(--crit-border-strong)"
          >
            <Site.card_title tag="h2" class="group-hover:text-(--crit-brand)">
              Build your own
            </Site.card_title>
            <Site.card_text>
              Your agent isn't listed? The review file and two commands are the whole protocol.
            </Site.card_text>
            <span class="mt-auto pt-3 text-sm font-semibold text-(--crit-brand)">
              Read the protocol <span aria-hidden="true">&rarr;</span>
            </span>
          </Site.card>
        </li>
      </Site.cards>

      <Site.links class="mt-10">
        <Site.link_arrow href="https://github.com/tomasz-tomczyk/crit/tree/main/integrations">
          View all integration files on GitHub
        </Site.link_arrow>
      </Site.links>
    </Site.wrap>
  </section>
</Layouts.site_page>
