<Layouts.site_page
  flash={@flash}
  current_scope={@current_scope}
  current_page={:modes}
  page_path={@conn.request_path}
>
  <Site.page_head eyebrow={@mode.eyebrow} tag="section">
    <:title><Site.dotted text={@mode.title} /></:title>
    <:lede>{@mode.lead}</:lede>
    <Site.chips items={@mode.tags} label={"What #{@mode.label} mode does"} class="mt-6" />
    <div class="flex flex-wrap items-center gap-6 mt-10">
      <CritWeb.PageHTML.github_star_link />
      <Site.link_arrow href={~p"/getting-started"}>Get Started</Site.link_arrow>
    </div>
    <div class="mt-14 max-md:mt-10">
      <CritWeb.PageHTML.mode_film mode={@mode} eager />
    </div>
  </Site.page_head>

  <Site.section panel>
    <Site.section_head>How it works<Site.dot /></Site.section_head>
    <Site.steps>
      <:step :for={step <- @mode.steps} title={step.h}>{Phoenix.HTML.raw(step.p)}</:step>
    </Site.steps>
  </Site.section>

  <Site.section>
    <Site.section_head>What you get<Site.dot /></Site.section_head>
    <Site.cards>
      <Site.card :for={feature <- @mode.features} tag="li">
        <Site.card_title>{feature.h}</Site.card_title>
        <Site.card_text>{feature.p}</Site.card_text>
      </Site.card>
    </Site.cards>
  </Site.section>

  <%= if cost = @mode[:cost] do %>
    <Site.section panel>
      <Site.section_head>
        <Site.dotted text={cost.title} />
        <:text>{cost.lead}</:text>
      </Site.section_head>
      <div class="overflow-x-auto rounded-xl border border-(--crit-border-strong)">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="bg-(--crit-bg-elevated)">
            <tr>
              <th class="px-4 py-3 font-mono text-xs font-normal tracking-[0.06em] uppercase text-(--crit-fg-muted)">
                Change size
              </th>
              <th class="px-4 py-3 font-mono text-xs font-normal tracking-[0.06em] uppercase text-(--crit-fg-muted)">
                What that usually means
              </th>
              <th class="px-4 py-3 font-mono text-xs font-normal tracking-[0.06em] uppercase text-(--crit-fg-muted)">
                Rough LLM spend
              </th>
            </tr>
          </thead>
          <tbody>
            <tr :for={row <- cost.rows} class="border-t border-(--crit-border)">
              <td class="px-4 py-3 font-medium align-top whitespace-nowrap">{row.size}</td>
              <td class="px-4 py-3 text-(--crit-fg-secondary) align-top">{row.detail}</td>
              <td class="px-4 py-3 text-(--crit-fg-secondary) align-top">{row.indication}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-(--crit-fg-muted) max-w-[960px]">
        {cost.footnote}
      </p>
    </Site.section>
  <% end %>

  <CritWeb.PageHTML.install_section id="mode-install" />

  <Site.section>
    <Site.eyebrow>Other review modes</Site.eyebrow>
    <Site.subnav label="Review modes" current={@conn.request_path}>
      <:item :for={mode <- CritWeb.PageHTML.modes()} href={"/modes/#{mode.slug}"}>
        {mode.label}
      </:item>
    </Site.subnav>
  </Site.section>
</Layouts.site_page>
