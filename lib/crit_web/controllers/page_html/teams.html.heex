          </li>
          <li class="flex gap-3 items-start">
            <span class="text-(--crit-brand) mt-0.5">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-4 h-4"
              >
                <circle cx="12" cy="12" r="9" /><polyline points="9 12 11 14 15 10" />
              </svg>
            </span>
            <div>
              <div class="text-sm font-semibold text-(--crit-fg-primary)">
                Pinned canonical reviews
              </div>
              <div class="text-sm text-(--crit-fg-secondary) mt-0.5">
                Permanent links for things like the team&rsquo;s review process or permissions matrix.
              </div>
            </div>
          </li>
        </ul>
      </div>
      <%!-- Showcase preview --%>
