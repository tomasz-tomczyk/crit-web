  <%!-- ===== Security ===== --%>
  <section class="border-b border-(--crit-border)">
    <div class="max-w-7xl mx-auto py-24 px-10 max-sm:px-4 max-sm:py-12 grid grid-cols-2 gap-20 items-start max-lg:grid-cols-1 max-lg:gap-10">
