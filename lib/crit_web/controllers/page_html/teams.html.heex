<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-(--crit-bg-page) text-(--crit-fg-primary) font-sans flex flex-col">
  <Layouts.site_header current_scope={@current_scope} />

  <%!-- ===== Hero ===== --%>
  <section class="relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto pt-24 px-10 pb-16 max-sm:px-4 max-sm:pt-14 max-sm:pb-10">
      <h1 class="text-7xl font-extrabold leading-none tracking-tight max-w-[920px] text-balance m-0 max-lg:text-6xl max-sm:text-5xl">
        The whole team in the loop<span class="text-(--crit-brand)">.</span>
      </h1>

      <p class="text-xl max-sm:text-base leading-relaxed text-(--crit-fg-secondary) max-w-2xl mt-6 mb-10">
        Crit Organizations turn your local-first review workflow into a shared one.
        Pool reviews across teammates, share inline comments, and keep agent
        handoffs visible &mdash; from the CLI to the browser. Your code stays local unless you explicitly share it.
      </p>

      <div class="flex gap-2.5 items-center flex-wrap">
        <a
          href={~p"/orgs/new"}
          class="inline-flex items-center justify-center gap-2 px-7 py-3 bg-(--crit-brand-cta) text-(--crit-fg-on-brand) rounded-lg text-sm font-bold no-underline hover:bg-(--crit-brand-cta-hover) transition-all"
        >
          Create an organization <.icon name="hero-arrow-right-mini" class="w-3.5 h-3.5" />
        </a>
        <a
          href={~p"/r/demo"}
          class="inline-flex items-center justify-center gap-2 px-7 py-3 border border-(--crit-border) text-(--crit-fg-secondary) rounded-lg text-sm font-semibold no-underline hover:border-(--crit-fg-muted) hover:text-(--crit-fg-primary) transition-all"
        >
          See an example review
        </a>
        <span class="text-xs text-(--crit-fg-muted) ml-1.5">
          Free during beta &middot; No card required
        </span>
      </div>

      <%!-- Product preview frame --%>
      <div
        class="mt-16 relative rounded-[14px] overflow-hidden border border-(--crit-border-strong) bg-(--crit-bg-card)"
        style="box-shadow: 0 30px 80px rgba(0,0,0,0.45), 0 0 0 1px rgba(122,162,247,0.06);"
      >
        <div class="grid grid-cols-[260px_1fr] min-h-[360px] text-[12px] max-md:grid-cols-1">
          <%!-- Sidebar --%>
          <div class="bg-(--crit-bg-page) border-r border-(--crit-border) max-md:border-r-0 max-md:border-b p-3.5 flex flex-col gap-1">
            <div class="flex items-center gap-2 py-1.5 px-2 bg-(--crit-bg-card) border border-(--crit-border) rounded-[7px] mb-2.5">
              <span class="w-5 h-5 rounded-[5px] bg-[rgba(122,162,247,0.18)] text-[#7aa2f7] font-semibold text-[8px] inline-flex items-center justify-center">
                A
              </span>
              <span class="font-semibold text-(--crit-fg-primary) text-[12px]">Acme, Inc.</span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-[11px] h-[11px] ml-auto opacity-50"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </div>
            <div class="text-[10px] text-(--crit-fg-muted) uppercase tracking-[0.1em] py-1.5 px-2">
              Shared reviews
            </div>
            <%!-- Active review --%>
            <div class="flex items-center gap-2 py-1.5 px-2 bg-(--crit-brand-bg) rounded-md text-(--crit-fg-primary)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-[11px] h-[11px] text-(--crit-orange)"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
              </svg>
              <span class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap">
                feat: org auto-join
              </span>
              <span class="text-[10px] text-(--crit-fg-muted)">14</span>
            </div>
            <%!-- Inactive reviews --%>
            <div class="flex items-center gap-2 py-1.5 px-2 rounded-md text-(--crit-fg-secondary)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-[11px] h-[11px] text-(--crit-green)"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
              </svg>
              <span class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap">
                fix: invite expiry
              </span>
              <span class="text-[10px] text-(--crit-fg-muted)">6</span>
            </div>
            <div class="flex items-center gap-2 py-1.5 px-2 rounded-md text-(--crit-fg-secondary)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-[11px] h-[11px] text-(--crit-orange)"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
              </svg>
              <span class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap">
                refactor: scope plug
              </span>
              <span class="inline-flex items-center py-0 px-[5px] text-[9px] rounded-full bg-(--crit-brand-bg) text-(--crit-brand) font-medium">
                you
              </span>
              <span class="text-[10px] text-(--crit-fg-muted)">21</span>
            </div>
            <div class="flex items-center gap-2 py-1.5 px-2 rounded-md text-(--crit-fg-secondary)">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-[11px] h-[11px] text-(--crit-brand)"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" />
              </svg>
              <span class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap">
                plan: SAML SSO
              </span>
              <span class="text-[10px] text-(--crit-fg-muted)">9</span>
            </div>
            <div class="flex-1"></div>
            <div class="py-1.5 px-2 text-[10px] text-(--crit-fg-muted) border-t border-(--crit-border) pt-2.5 mt-1.5">
              14 members &middot; 7 active
            </div>
          </div>

          <%!-- Review body --%>
          <div class="p-[18px] font-mono text-[12px] leading-[1.6] relative overflow-hidden">
            <div class="flex items-center gap-2.5 mb-3.5 font-sans">
              <span class="text-[13px] font-semibold text-(--crit-fg-primary)">
                feat: org auto-join via verified domains
              </span>
              <span class="inline-flex items-center py-[1px] px-[7px] text-[10px] rounded-full bg-[rgba(255,158,100,0.12)] text-(--crit-orange) font-medium">
                Round 2
              </span>
              <span class="inline-flex items-center py-[1px] px-[7px] text-[10px] rounded-full border border-(--crit-border) text-(--crit-fg-muted) font-medium">
                14 comments
              </span>
              <div class="ml-auto flex">
                <span class="border-2 border-(--crit-bg-card) rounded-full">
                  <span class="w-5 h-5 rounded-full bg-[rgba(187,154,247,0.18)] text-[#bb9af7] text-[8px] font-semibold inline-flex items-center justify-center">
                    M
                  </span>
                </span>
                <span class="-ml-1.5 border-2 border-(--crit-bg-card) rounded-full">
                  <span class="w-5 h-5 rounded-full bg-[rgba(158,206,106,0.20)] text-[#9ece6a] text-[8px] font-semibold inline-flex items-center justify-center">
                    S
                  </span>
                </span>
                <span class="-ml-1.5 border-2 border-(--crit-bg-card) rounded-full">
                  <span class="w-5 h-5 rounded-full bg-[rgba(255,158,100,0.18)] text-[#ff9e64] text-[8px] font-semibold inline-flex items-center justify-center">
                    T
                  </span>
                </span>
              </div>
            </div>
            <%!-- Code lines --%>
            <div class="grid grid-cols-[36px_1fr] text-(--crit-fg-secondary) rounded-lg overflow-hidden bg-(--crit-bg-page) border border-(--crit-border)">
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-(--crit-bg-gutter) border-r border-(--crit-border)">
                22
              </div>
              <div class="py-[3px] px-2.5" phx-no-curly-interpolation>## Auto-join behavior</div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-(--crit-bg-gutter) border-r border-(--crit-border)">
                23
              </div>
              <div class="py-[3px] px-2.5">&nbsp;</div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-(--crit-bg-gutter) border-r border-(--crit-border)">
                24
              </div>
              <div class="py-[3px] px-2.5">
                When a user signs in with a verified domain email, we now
              </div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-(--crit-bg-gutter) border-r border-(--crit-border)">
                25
              </div>
              <div class="py-[3px] px-2.5">add them to the org as a Member by default.</div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-(--crit-bg-gutter) border-r border-(--crit-border)">
                26
              </div>
              <div class="py-[3px] px-2.5">&nbsp;</div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-[rgba(86,211,100,0.08)] border-r border-(--crit-border)">
                +
              </div>
              <div class="py-[3px] px-2.5 bg-[rgba(86,211,100,0.06)] text-(--crit-green)">
                + Skip auto-join if the user already has 5 memberships.
              </div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-[rgba(86,211,100,0.08)] border-r border-(--crit-border)">
                +
              </div>
              <div class="py-[3px] px-2.5 bg-[rgba(86,211,100,0.06)] text-(--crit-green)">
                + Allow admins to override the default role per domain.
              </div>
              <div class="py-[3px] px-2 text-right text-(--crit-fg-muted) bg-(--crit-bg-gutter) border-r border-(--crit-border)">
                29
              </div>
              <div class="py-[3px] px-2.5">&nbsp;</div>
            </div>

            <%!-- Comment thread --%>
            <div class="mt-3.5 p-3 bg-(--crit-comment-bg) border border-(--crit-border-comment) rounded-lg font-sans">
              <div class="flex gap-[9px] items-start">
                <span class="w-5 h-5 rounded-full bg-[rgba(187,154,247,0.18)] text-[#bb9af7] text-[8px] font-semibold inline-flex items-center justify-center shrink-0">
                  M
                </span>
                <div class="flex-1">
                  <div class="flex items-baseline gap-2">
                    <span class="font-semibold text-[12px] text-(--crit-fg-primary)">
                      Mira Patel
                    </span>
                    <span class="inline-flex items-center py-0 px-[5px] text-[9px] rounded-full bg-(--crit-brand-bg) text-(--crit-brand) font-medium">
                      Admin
                    </span>
                    <span class="text-[11px] text-(--crit-fg-muted)">commented on line 26</span>
                  </div>
                  <p class="mt-1.5 mb-0 text-[12px] text-(--crit-fg-secondary) leading-[1.5]">
                    Should this also fire the org-join webhook? Otherwise our audit log
                    misses every auto-join. Worth a follow-up round.
                  </p>
                </div>
              </div>
              <div class="flex gap-[9px] items-start mt-3 pt-3 border-t border-dashed border-(--crit-border)">
                <span class="w-5 h-5 rounded-full bg-[rgba(255,158,100,0.18)] text-[#ff9e64] text-[8px] font-semibold inline-flex items-center justify-center shrink-0">
                  A
                </span>
                <div class="flex-1">
                  <div class="flex items-baseline gap-2">
                    <span class="font-semibold text-[12px] text-(--crit-fg-primary)">Agent</span>
                    <span class="inline-flex items-center py-0 px-[5px] text-[9px] rounded-full bg-[rgba(255,158,100,0.12)] text-(--crit-orange) font-medium">
                      Claude Code
                    </span>
                    <span class="text-[11px] text-(--crit-fg-muted)">5s ago</span>
                  </div>
                  <p class="mt-1.5 mb-0 text-[12px] text-(--crit-fg-secondary) leading-[1.5]">
                    Good catch. Added
                    <code
                      class="bg-(--crit-code-bg) py-0 px-1 rounded-[3px] font-mono text-[11px]"
                      phx-no-curly-interpolation
                    >
                      Webhook.emit(:org_member_added, ...)
                    </code>
                    after the membership insert. Tests added. Pushing for round 3.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Logos ===== --%>
  <section>
    <div class="max-w-7xl mx-auto py-8 px-10 max-sm:px-4">
      <div class="text-sm text-(--crit-fg-muted) text-center mb-6">Teams planning with Crit</div>
      <div class="flex items-center justify-center gap-16 max-sm:gap-8 max-sm:flex-wrap">
        <img src="/images/logos/spotify.svg" alt="Spotify" class="w-28 brightness-0 invert opacity-40 hover:opacity-70 transition-opacity duration-300" loading="lazy" />
        <img src="/images/logos/forter.svg" alt="Forter" class="w-24 brightness-0 invert opacity-40 hover:opacity-70 transition-opacity duration-300" loading="lazy" />
        <img src="/images/logos/addepar.svg" alt="Addepar" class="w-28 brightness-0 invert opacity-40 hover:opacity-70 transition-opacity duration-300" loading="lazy" />
      </div>
    </div>
  </section>

  <%!-- ===== Feature Grid ===== --%>
  <section class="border-b border-(--crit-border)">
    <div class="max-w-7xl mx-auto py-24 px-10 max-sm:px-4 max-sm:py-12">
      <div class="font-mono text-xs uppercase tracking-widest text-(--crit-brand) mb-3">
        What&rsquo;s in the box
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight max-w-[760px] text-balance mb-4 max-sm:text-2xl">
        Built for the way teams actually review AI&nbsp;output<span class="text-(--crit-brand)">.</span>
      </h2>
      <p class="text-lg text-(--crit-fg-secondary) max-w-2xl leading-relaxed max-sm:text-base">
        The same local-first loop you&rsquo;ve used solo &mdash; now with the parts a team needs.
        No new tool to learn, no second login.
      </p>

      <div class="mt-12 grid grid-cols-3 gap-px bg-(--crit-border) border border-(--crit-border) rounded-xl overflow-hidden max-md:grid-cols-1">
        <div class="p-7 bg-(--crit-bg-page)">
          <span class="w-9 h-9 rounded-[9px] bg-(--crit-brand-bg) text-(--crit-brand) inline-flex items-center justify-center mb-4">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[17px] h-[17px]"
            >
              <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle
                cx="18"
                cy="19"
                r="3"
              /><line x1="8.6" y1="13.5" x2="15.4" y2="17.5" /><line
                x1="15.4"
                y1="6.5"
                x2="8.6"
                y2="10.5"
              />
            </svg>
          </span>
          <h3 class="text-lg font-semibold tracking-tight mb-2">
            Pool reviews across the team
          </h3>
          <p class="text-sm text-(--crit-fg-secondary) leading-relaxed m-0">
            Share reviews into an org-wide inbox. No more passing /r/ links in Slack.
          </p>
        </div>
        <div class="p-7 bg-(--crit-bg-page)">
          <span class="w-9 h-9 rounded-[9px] bg-(--crit-brand-bg) text-(--crit-brand) inline-flex items-center justify-center mb-4">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[17px] h-[17px]"
            >
              <path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-4-1L3 21l2-5.5A8.4 8.4 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5z" />
            </svg>
          </span>
          <h3 class="text-lg font-semibold tracking-tight mb-2">
            Threaded inline comments
          </h3>
          <p class="text-sm text-(--crit-fg-secondary) leading-relaxed m-0">
            Highlight lines, drop comments, and reply in threads. Resolve when done.
          </p>
        </div>
        <div class="p-7 bg-(--crit-bg-page)">
          <span class="w-9 h-9 rounded-[9px] bg-(--crit-brand-bg) text-(--crit-brand) inline-flex items-center justify-center mb-4">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[17px] h-[17px]"
            >
              <path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6z" /><polyline points="9 12 11 14 15 10" />
            </svg>
          </span>
          <h3 class="text-lg font-semibold tracking-tight mb-2">
            Scoped to your org
          </h3>
          <p class="text-sm text-(--crit-fg-secondary) leading-relaxed m-0">
            Every review is org-scoped. Cross-org leaks are impossible by design &mdash; enforced at the schema, query, and authorization layer.
          </p>
        </div>
        <div class="p-7 bg-(--crit-bg-page)">
          <span class="w-9 h-9 rounded-[9px] bg-(--crit-brand-bg) text-(--crit-brand) inline-flex items-center justify-center mb-4">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[17px] h-[17px]"
            >
              <rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 4l-10 8L2 4" />
            </svg>
          </span>
          <h3 class="text-lg font-semibold tracking-tight mb-2">
            Email invites
          </h3>
          <p class="text-sm text-(--crit-fg-secondary) leading-relaxed m-0">
            Invite teammates by email. They accept with one click and land in the org immediately.
          </p>
        </div>
        <div class="p-7 bg-(--crit-bg-page)">
          <span class="w-9 h-9 rounded-[9px] bg-(--crit-brand-bg) text-(--crit-brand) inline-flex items-center justify-center mb-4">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[17px] h-[17px]"
            >
              <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" /><circle cx="10" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M17 3.13A4 4 0 0 1 17 11" />
            </svg>
          </span>
          <h3 class="text-lg font-semibold tracking-tight mb-2">
            Roles that match real teams
          </h3>
          <p class="text-sm text-(--crit-fg-secondary) leading-relaxed m-0">
            Admin + Member roles today. Invite teammates with a link, control who can manage the org.
          </p>
        </div>
        <div class="p-7 bg-(--crit-bg-page)">
          <span class="w-9 h-9 rounded-[9px] bg-(--crit-brand-bg) text-(--crit-brand) inline-flex items-center justify-center mb-4">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-[17px] h-[17px]"
            >
              <path d="M16 3l4 4-4 4" /><path d="M4 7h16" /><path d="M8 21l-4-4 4-4" /><path d="M20 17H4" />
            </svg>
          </span>
          <h3 class="text-lg font-semibold tracking-tight mb-2">
            Multi-org switching
          </h3>
          <p class="text-sm text-(--crit-fg-secondary) leading-relaxed m-0">
            Belong to your day-job, your side project, and an open-source crew &mdash; without juggling accounts.
          </p>
        </div>
      </div>
      <p class="text-sm text-(--crit-fg-muted) mt-6">
        Shared inbox, activity feed, and pinned reviews are on the roadmap &mdash; the rest is live today.
      </p>
    </div>
  </section>

  <%!-- ===== Testimonials ===== --%>
  <section class="border-b border-(--crit-border)">
    <div class="max-w-7xl mx-auto py-24 px-10 max-sm:px-4 max-sm:py-12">
      <div class="font-mono text-xs uppercase tracking-widest text-(--crit-brand) mb-3">What people are saying</div>
      <div class="grid grid-cols-3 gap-8 max-lg:grid-cols-1 max-lg:gap-6">
        <div class="flex flex-col gap-2">
          <p class="text-base font-semibold leading-snug">&ldquo;A clean local UI to batch my feedback and iterate.&rdquo;</p>
          <div class="flex items-center gap-2.5 mt-auto pt-1">
            <img src="/images/testimonials/omervk.jpg" alt="Omer" class="size-7 rounded-full bg-(--crit-bg-elevated)" loading="lazy" width="28" height="28" />
            <p class="text-xs text-(--crit-fg-muted)">Omer &middot; Principal Engineer</p>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <p class="text-base font-semibold leading-snug">&ldquo;Like a pull request review but for your plan.&rdquo;</p>
          <div class="flex items-center gap-2.5 mt-auto pt-1">
            <img src="/images/testimonials/vineus.jpg" alt="Vincent" class="size-7 rounded-full bg-(--crit-bg-elevated)" loading="lazy" width="28" height="28" />
            <p class="text-xs text-(--crit-fg-muted)">Vincent &middot; Senior Software Engineer</p>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <p class="text-base font-semibold leading-snug">&ldquo;Genuinely game changing for agentic workflows.&rdquo;</p>
          <div class="flex items-center gap-2.5 mt-auto pt-1">
            <img src="/images/testimonials/vereisyaps.png" alt="@vereisyaps" class="size-7 rounded-full bg-(--crit-bg-elevated)" loading="lazy" width="28" height="28" />
            <p class="text-xs text-(--crit-fg-muted)">@vereisyaps &middot; Tech Lead</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ===== Showcase ===== --%>
  <section class="border-b border-(--crit-border)">
    <div class="max-w-7xl mx-auto py-24 px-10 max-sm:px-4 max-sm:py-12 grid grid-cols-2 gap-20 items-center max-lg:grid-cols-1 max-lg:gap-10">
