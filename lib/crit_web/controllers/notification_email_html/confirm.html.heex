<Layouts.site_page
  flash={@flash}
  current_scope={@current_scope}
  page_path="/settings/notification-emails/confirm"
>
  <Site.wrap class="max-w-[calc(36rem+7rem)] py-24 max-md:py-14">
    <%= case @state do %>
      <% :pending -> %>
        <h1 class="text-[clamp(30px,3.6vw,48px)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance">
          Confirm this address
        </h1>
        <p class="mt-4 text-lg text-(--crit-fg-secondary)">
          Crit will send discussion notifications to {@email} after you confirm.
          Nothing has been sent there yet.
        </p>
        <.form
          for={%{}}
          id="notification-email-confirmation"
          action={~p"/settings/notification-emails/confirm/#{@token}"}
          class="mt-6"
        >
          <button
            type="submit"
            class={[CritWeb.SiteComponents.btn_class("primary"), "cursor-pointer"]}
          >
            Confirm address
          </button>
        </.form>
      <% :confirmed -> %>
        <h1 class="text-[clamp(30px,3.6vw,48px)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance">
          This address is confirmed
        </h1>
        <p class="mt-4 text-lg text-(--crit-fg-secondary)">
          {@email} already receives discussion notifications.
        </p>
      <% :done -> %>
        <h1 class="text-[clamp(30px,3.6vw,48px)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance">
          Address confirmed
        </h1>
        <p class="mt-4 text-lg text-(--crit-fg-secondary)">
          {@email} will now receive discussion notifications.
        </p>
      <% :invalid -> %>
        <h1 class="text-[clamp(30px,3.6vw,48px)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance">
          Link not valid
        </h1>
        <p class="mt-4 text-lg text-(--crit-fg-secondary)">
          This link has expired, or the address was removed before it was confirmed.
        </p>
    <% end %>
  </Site.wrap>
</Layouts.site_page>
