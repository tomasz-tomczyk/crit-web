<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-(--crit-bg-page) text-(--crit-fg-primary) font-sans flex flex-col">
  <Layouts.dashboard_header
    current_scope={@current_scope}
    show_overview_link={@selfhosted}
    current_page={:org_members}
    orgs={@orgs}
  />

  <div class="max-w-7xl mx-auto w-full px-8 my-10 max-sm:px-4">
    <%!-- Page head --%>
    <div class="flex items-end justify-between mb-6 gap-4 max-sm:flex-col max-sm:items-start">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-(--crit-fg-muted) mb-2">
          {@org.name}
        </p>
        <h1 class="text-[24px] font-bold tracking-[-0.02em] text-(--crit-fg-primary)">Members</h1>
        <p class="text-[14px] text-(--crit-fg-secondary) mt-1">
          Invite teammates, review pending invitations, and manage roles.
        </p>
      </div>
      <div :if={@is_admin} class="flex gap-2 shrink-0">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium text-(--crit-fg-secondary) bg-(--crit-bg-page) border border-(--crit-border) rounded-md hover:bg-(--crit-bg-elevated) transition-colors cursor-default"
        >
          <.icon name="hero-arrow-top-right-on-square" class="size-3.5" /> Export
        </button>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium text-white bg-(--crit-brand) rounded-md hover:opacity-90 transition-opacity cursor-default"
        >
          <.icon name="hero-plus" class="size-3.5" /> Invite members
        </button>
      </div>
    </div>

    <%!-- Seat usage bar --%>
    <div class="bg-(--crit-bg-card) border border-(--crit-border) rounded-xl p-4 mb-6 flex items-center gap-5">
      <div class="flex-1 min-w-0">
        <div class="flex items-baseline gap-2.5">
          <span class="text-[15px] font-semibold">Seats</span>
          <span class="text-[13px] text-(--crit-fg-muted)">
            <span class="font-mono font-semibold text-(--crit-fg-primary)">{length(@members)}</span>
            of {length(@members)} used &middot; 0 remaining
          </span>
        </div>
        <div class="mt-2.5 h-1.5 rounded-full bg-(--crit-bg-elevated) overflow-hidden">
          <div class="h-full bg-(--crit-brand) rounded-full" style="width: 100%"></div>
        </div>
      </div>
      <button
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium text-(--crit-fg-secondary) bg-(--crit-bg-page) border border-(--crit-border) rounded-md hover:bg-(--crit-bg-elevated) transition-colors cursor-default"
      >
        <.icon name="hero-bolt" class="size-3.5" /> Add seats
      </button>
    </div>

    <%!-- Invite by email (admin only) --%>
    <section :if={@is_admin} class="mb-9">
      <h2 class="text-[16px] font-semibold text-(--crit-fg-primary) pb-3 border-b border-(--crit-border) mb-6">
        Invite by email
      </h2>
      <div class="bg-(--crit-bg-card) border border-(--crit-border) rounded-xl p-[18px]">
        <.form
          for={@invite_form}
          id="send_invite_form"
          phx-change="validate_invite"
          phx-submit="send_invite"
          class="flex gap-2.5 items-start max-sm:flex-col max-sm:items-stretch"
        >
          <div class="flex-1 min-w-0">
            <input
              type="text"
              name={@invite_form[:email].name}
              id={@invite_form[:email].id}
              value={Phoenix.HTML.Form.normalize_value("text", @invite_form[:email].value)}
              placeholder="teammate@example.com, another@example.com..."
              autocomplete="off"
              class="block w-full px-3 py-2.5 text-[14px] bg-(--crit-bg-page) border border-(--crit-border) rounded-md text-(--crit-fg-primary) placeholder:text-(--crit-fg-muted) focus:outline-none focus:border-(--crit-brand) focus:shadow-[0_0_0_3px_var(--crit-brand-subtle)] transition-[border-color] leading-normal"
            />
            <p
              :for={msg <- Enum.map(@invite_form[:email].errors, &translate_error/1)}
              class="text-xs text-(--crit-red) mt-1.5"
            >
              {msg}
            </p>
            <p class="text-[12px] text-(--crit-fg-muted) mt-1.5">
              Paste multiple emails, separated by commas, spaces, or new lines.
            </p>
          </div>
          <div class="w-40 max-sm:w-full">
            <label class="block font-mono text-[11px] uppercase tracking-[0.08em] text-(--crit-fg-muted) mb-1.5">
              Default role
            </label>
            <select
              name={@invite_form[:role].name}
              id={@invite_form[:role].id}
              class="block w-full px-3 py-2.5 text-[14px] bg-(--crit-bg-page) border border-(--crit-border) rounded-md text-(--crit-fg-primary) focus:outline-none focus:border-(--crit-brand)"
            >
              <option value="member" selected={@invite_form[:role].value in [nil, "", "member"]}>
                Member
              </option>
              <option value="admin" selected={@invite_form[:role].value == "admin"}>Admin</option>
            </select>
          </div>
          <div class="pt-6 max-sm:pt-0">
            <button
              type="submit"
              phx-disable-with="Sending..."
              class="inline-flex items-center gap-1.5 px-4 py-2.5 text-[13px] font-medium text-white bg-(--crit-brand) rounded-md hover:opacity-90 transition-opacity whitespace-nowrap"
            >
              <.icon name="hero-envelope" class="size-3.5" /> Send invites
            </button>
          </div>
        </.form>

        <div class="mt-4 pt-4 border-t border-dashed border-(--crit-border) flex items-center gap-3.5 text-[12px] text-(--crit-fg-muted)">
          <.icon name="hero-globe-alt" class="size-3.5 shrink-0" />
          <span>
            Anyone with an <span class="font-mono text-(--crit-fg-secondary)">@acme.dev</span> email can join without an invite.
          </span>
          <button type="button" class="ml-auto text-(--crit-brand) font-medium hover:underline whitespace-nowrap">
            Configure domain &rarr;
          </button>
        </div>
      </div>
    </section>

    <%!-- Tabs + filters --%>
    <div class="flex items-center justify-between mb-4 gap-3 max-sm:flex-col max-sm:items-stretch">
      <div class="inline-flex gap-0.5 bg-(--crit-bg-card) border border-(--crit-border) rounded-lg p-[3px]">
        <button
          type="button"
          class="px-3 py-1 text-[13px] font-medium rounded-md bg-(--crit-bg-elevated) text-(--crit-fg-primary)"
        >
          Active <span class="text-(--crit-fg-muted) ml-1.5">{length(@members)}</span>
        </button>
        <button
          type="button"
          class="px-3 py-1 text-[13px] font-medium rounded-md text-(--crit-fg-muted) hover:text-(--crit-fg-primary) transition-colors"
        >
          Pending <span class="ml-1.5">{length(@invites)}</span>
        </button>
        <button
          type="button"
          class="px-3 py-1 text-[13px] font-medium rounded-md text-(--crit-fg-muted) hover:text-(--crit-fg-primary) transition-colors"
        >
          Removed <span class="ml-1.5">0</span>
        </button>
      </div>
      <div class="flex gap-2">
        <div class="relative w-60 max-sm:flex-1">
          <.icon
            name="hero-magnifying-glass"
            class="size-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-(--crit-fg-muted)"
          />
          <input
            type="text"
            placeholder="Filter by name or email..."
            disabled
            class="w-full pl-8 pr-3 py-1.5 text-[13px] bg-(--crit-bg-page) border border-(--crit-border) rounded-md text-(--crit-fg-primary) placeholder:text-(--crit-fg-muted) focus:outline-none focus:border-(--crit-brand)"
          />
        </div>
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-[13px] font-medium text-(--crit-fg-secondary) bg-(--crit-bg-page) border border-(--crit-border) rounded-md hover:bg-(--crit-bg-elevated) transition-colors cursor-default"
        >
          <.icon name="hero-funnel" class="size-3.5" /> Role: All
        </button>
      </div>
    </div>

    <%!-- Active members table --%>
    <section class="mb-7">
      <div class="bg-(--crit-bg-card) border border-(--crit-border) rounded-xl overflow-hidden">
        <table class="w-full text-[13px]">
          <thead>
            <tr class="border-b border-(--crit-border)">
              <th class="w-[52px] pl-[18px] pr-0 py-2.5 text-left">
                <input
                  type="checkbox"
                  disabled
                  class="rounded border-(--crit-border) bg-(--crit-bg-page)"
                  style="accent-color: var(--crit-brand);"
                />
              </th>
              <th class="text-left py-2.5 pr-4 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider">
                Member
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider">
                Role
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider">
                Reviews
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider max-sm:hidden">
                Joined
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider max-sm:hidden">
                Last seen
              </th>
              <th class="text-right pr-[18px] py-2.5">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <%= for {member, idx} <- Enum.with_index(@members) do %>
              <tr class="border-b border-(--crit-border) last:border-b-0 hover:bg-(--crit-bg-elevated) group">
                <td class="w-[52px] pl-[18px] pr-0 py-3">
                  <input
                    type="checkbox"
                    disabled
                    class="rounded border-(--crit-border) bg-(--crit-bg-page)"
                    style="accent-color: var(--crit-brand);"
                  />
                </td>

                <%!-- Member: avatar + name + email --%>
                <td class="py-3 pr-4">
                  <div class="flex items-center gap-2.5">
                    <%= if member.user.avatar_url do %>
                      <img
                        src={member.user.avatar_url}
                        alt=""
                        class="h-7 w-7 rounded-full flex-shrink-0"
                      />
                    <% else %>
                      <span
                        class="h-7 w-7 rounded-full inline-flex items-center justify-center text-[10px] font-semibold flex-shrink-0"
                        style="background: rgba(122,162,247,0.18); color: #7aa2f7;"
                      >
                        {String.first(member.user.name || member.user.email || "?")
                        |> String.upcase()}
                      </span>
                    <% end %>
                    <div class="min-w-0">
                      <div class="font-semibold text-[13px] text-(--crit-fg-primary) truncate">
                        {member.user.name || "—"}
                        <span
                          :if={member.user.id == @current_user_id}
                          class="text-(--crit-fg-muted) font-normal ml-1.5"
                        >
                          (you)
                        </span>
                      </div>
                      <div class="text-[12px] text-(--crit-fg-muted) truncate">
                        {member.user.email}
                      </div>
                    </div>
                  </div>
                </td>

                <%!-- Role --%>
                <td class="px-4 py-3">
                  <%= if @is_admin and member.user.id != @current_user_id do %>
                    <form phx-change="change_role" class="inline-flex">
                      <input type="hidden" name="user_id" value={member.user.id} />
                      <select
                        name="role"
                        class="w-[100px] px-2 py-1 text-[12px] bg-(--crit-bg-card) border border-(--crit-border) rounded text-(--crit-fg-primary) focus:outline-none focus:border-(--crit-brand)"
                      >
                        <option value="admin" selected={member.role == "admin"}>Admin</option>
                        <option value="member" selected={member.role == "member"}>Member</option>
                      </select>
                    </form>
                  <% else %>
                    <span class={[
                      "inline-flex px-2 py-0.5 text-[11px] font-medium rounded-full",
                      if(member.role == "admin",
                        do: "bg-(--crit-brand-bg) text-(--crit-brand)",
                        else: "bg-(--crit-bg-elevated) text-(--crit-fg-muted)"
                      )
                    ]}>
                      {String.capitalize(member.role)}
                    </span>
                  <% end %>
                </td>

                <%!-- Reviews (placeholder) --%>
                <td class="px-4 py-3">
                  <span class="font-mono text-[12px] text-(--crit-fg-primary)">
                    {idx * 10 + 4}
                  </span>
                </td>

                <%!-- Joined (placeholder) --%>
                <td class="px-4 py-3 text-[12px] text-(--crit-fg-secondary) max-sm:hidden">
                  <%= case rem(idx, 3) do %>
                    <% 0 -> %>
                      Jan 2024
                    <% 1 -> %>
                      Mar 2024
                    <% _ -> %>
                      Nov 2024
                  <% end %>
                </td>

                <%!-- Last seen (placeholder) --%>
                <td class="px-4 py-3 max-sm:hidden">
                  <%= cond do %>
                    <% idx < 2 -> %>
                      <span class="inline-flex items-center gap-1.5 text-[12px]">
                        <span class="h-1.5 w-1.5 rounded-full bg-(--crit-green) shrink-0"></span>
                        <span class="text-(--crit-green)">Active now</span>
                      </span>
                    <% idx < 4 -> %>
                      <span class="text-[12px] text-(--crit-fg-secondary)">Yesterday</span>
                    <% true -> %>
                      <span class="text-[12px] text-(--crit-fg-secondary)">5 days ago</span>
                  <% end %>
                </td>

                <%!-- Actions --%>
                <td class="pr-[18px] py-3 text-right">
                  <%= cond do %>
                    <% member.user.id == @current_user_id -> %>
                      <button
                        type="button"
                        phx-click="leave"
                        data-confirm="Leave this organization?"
                        class="text-[12px] font-medium text-(--crit-red) hover:underline opacity-0 group-hover:opacity-100 transition-opacity"
                      >
                        Leave
                      </button>
                    <% @is_admin -> %>
                      <button
                        type="button"
                        phx-click="remove_member"
                        phx-value-user_id={member.user.id}
                        data-confirm={"Remove #{member.user.name || member.user.email} from this organization?"}
                        class="text-[12px] font-medium text-(--crit-red) hover:underline opacity-0 group-hover:opacity-100 transition-opacity"
                      >
                        Remove
                      </button>
                    <% true -> %>
                      <span></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Pending invites (collapsed details) --%>
    <details :if={@is_admin and @invites != []} class="mb-8">
      <summary class="cursor-pointer list-none flex items-center gap-2 text-[13px] text-(--crit-fg-secondary) py-2 select-none">
        <.icon name="hero-chevron-right" class="size-3 transition-transform [[open]>&]:rotate-90" />
        <span>
          <strong class="text-(--crit-fg-primary)">{length(@invites)} pending {if length(@invites) == 1, do: "invite", else: "invites"}</strong>
          awaiting response
        </span>
      </summary>

      <div class="mt-3 bg-(--crit-bg-card) border border-(--crit-border) rounded-xl overflow-hidden">
        <table class="w-full text-[13px]">
          <thead>
            <tr class="border-b border-(--crit-border)">
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider">
                Email
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider">
                Role
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider max-sm:hidden">
                Invited by
              </th>
              <th class="text-left px-4 py-2.5 font-medium text-(--crit-fg-muted) text-[11px] uppercase tracking-wider">
                Expires
              </th>
              <th class="text-right px-4 py-2.5">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={invite <- @invites}
              class="border-b border-(--crit-border) last:border-b-0 hover:bg-(--crit-bg-elevated)"
            >
              <td class="px-4 py-3 text-(--crit-fg-primary) font-medium">
                {invite.email}
              </td>
              <td class="px-4 py-3">
                <span class={[
                  "inline-flex px-2 py-0.5 text-[11px] font-medium rounded-full",
                  if(invite.role == "admin",
                    do: "bg-(--crit-brand-bg) text-(--crit-brand)",
                    else: "bg-(--crit-bg-elevated) text-(--crit-fg-muted)"
                  )
                ]}>
                  {String.capitalize(invite.role)}
                </span>
              </td>
              <td class="px-4 py-3 text-[12px] text-(--crit-fg-secondary) max-sm:hidden">
                {invite.invited_by.name || invite.invited_by.email}
              </td>
              <td class="px-4 py-3 text-[12px] text-(--crit-fg-secondary)">
                {CritWeb.OrgMembersLive.expires_label(invite)}
              </td>
              <td class="px-4 py-3 text-right">
                <button
                  type="button"
                  phx-click="resend_invite"
                  phx-value-id={invite.id}
                  class="text-[12px] font-medium text-(--crit-fg-secondary) hover:text-(--crit-fg-primary) hover:underline mr-3"
                >
                  Resend
                </button>
                <button
                  type="button"
                  phx-click="revoke_invite"
                  phx-value-id={invite.id}
                  data-confirm={"Revoke invite for #{invite.email}?"}
                  class="text-[12px] font-medium text-(--crit-red) hover:underline"
                >
                  Revoke
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>
  </div>
</div>
