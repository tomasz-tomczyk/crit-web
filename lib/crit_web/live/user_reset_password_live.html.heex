<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-(--crit-bg-page) text-(--crit-fg-primary) font-sans flex flex-col">
  <Layouts.dashboard_header current_scope={@current_scope} />

  <div class="max-w-md mx-auto w-full px-6 my-16 max-sm:px-4 max-sm:my-10">
    <h1 class="text-2xl font-semibold text-(--crit-fg-primary) mb-2">Set a new password</h1>
    <p class="text-sm text-(--crit-fg-muted) mb-8">
      Choose a strong password you don't use elsewhere.
    </p>

    <div class="bg-(--crit-bg-card) border border-(--crit-border) rounded-lg p-6">
      <.form for={@form} id="reset_form" phx-submit="save" class="flex flex-col gap-4">
        <div>
          <label
            for={@form[:password].id}
            class="block text-sm font-medium text-(--crit-fg-primary) mb-1.5"
          >
            New password
          </label>
          <input
            type="password"
            id={@form[:password].id}
            name={@form[:password].name}
            required
            autocomplete="new-password"
            class={[
              "w-full bg-(--crit-bg-page) border rounded-md px-3 py-2 text-sm text-(--crit-fg-primary) placeholder-(--crit-fg-muted) focus:outline-none transition-colors",
              if(
                Phoenix.Component.used_input?(@form[:password]) and @form[:password].errors != [],
                do: "border-(--crit-red) focus:border-(--crit-red)",
                else: "border-(--crit-border) focus:border-(--crit-brand)"
              )
            ]}
          />
          <p
            :for={err <- @form[:password].errors}
            :if={Phoenix.Component.used_input?(@form[:password])}
            class="mt-1.5 text-xs text-(--crit-red)"
          >
            {CritWeb.CoreComponents.translate_error(err)}
          </p>
        </div>

        <div>
          <label
            for={@form[:password_confirmation].id}
            class="block text-sm font-medium text-(--crit-fg-primary) mb-1.5"
          >
            Confirm new password
          </label>
          <input
            type="password"
            id={@form[:password_confirmation].id}
            name={@form[:password_confirmation].name}
            required
            autocomplete="new-password"
            class={[
              "w-full bg-(--crit-bg-page) border rounded-md px-3 py-2 text-sm text-(--crit-fg-primary) placeholder-(--crit-fg-muted) focus:outline-none transition-colors",
              if(
                Phoenix.Component.used_input?(@form[:password_confirmation]) and
                  @form[:password_confirmation].errors != [],
                do: "border-(--crit-red) focus:border-(--crit-red)",
                else: "border-(--crit-border) focus:border-(--crit-brand)"
              )
            ]}
          />
          <p
            :for={err <- @form[:password_confirmation].errors}
            :if={Phoenix.Component.used_input?(@form[:password_confirmation])}
            class="mt-1.5 text-xs text-(--crit-red)"
          >
            {CritWeb.CoreComponents.translate_error(err)}
          </p>
        </div>

        <button
          type="submit"
          class="w-full mt-2 px-4 py-2 bg-(--crit-brand-cta) text-(--crit-fg-on-brand) rounded-lg text-sm font-bold hover:bg-(--crit-brand-cta-hover) transition-colors cursor-pointer"
        >
          Reset password
        </button>
      </.form>
    </div>
  </div>
</div>
