<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-slate-50 flex flex-col">
  <header class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <.link navigate={~p"/"} class="text-lg font-semibold text-slate-900 no-underline">
        crit
      </.link>
    </div>
  </header>

  <main class="flex-1 py-16 px-4">
    <div class="max-w-2xl mx-auto w-full">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-bold text-slate-900">Account settings</h1>
        <.link
          href={~p"/auth/logout"}
          method="delete"
          class="text-sm font-medium text-slate-600 hover:text-slate-900 underline"
        >
          Sign out
        </.link>
      </div>

      <section class="bg-white border border-slate-200 rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Change email</h2>

        <.form
          for={@email_form}
          id="email_form"
          phx-submit="update_email"
          phx-change="validate_email"
          class="flex flex-col gap-4"
        >
          <div>
            <label
              for={@email_form[:email].id}
              class="block text-sm font-medium text-slate-900 mb-1.5"
            >
              New email
            </label>
            <input
              type="email"
              id={@email_form[:email].id}
              name={@email_form[:email].name}
              value={Phoenix.HTML.Form.normalize_value("email", @email_form[:email].value)}
              required
              autocomplete="email"
              class={[
                "w-full bg-white rounded-md px-3 py-2 text-sm text-slate-900 placeholder-slate-400 border focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
                if(
                  Phoenix.Component.used_input?(@email_form[:email]) and
                    @email_form[:email].errors != [],
                  do: "border-red-300",
                  else: "border-slate-300"
                )
              ]}
            />
            <p
              :for={err <- @email_form[:email].errors}
              :if={Phoenix.Component.used_input?(@email_form[:email])}
              class="mt-1.5 text-xs text-red-700"
            >
              {CritWeb.CoreComponents.translate_error(err)}
            </p>
          </div>

          <div>
            <button
              type="submit"
              phx-disable-with="Sending..."
              class="bg-blue-600 hover:bg-blue-700 text-white rounded-md px-4 py-2 text-sm font-medium transition cursor-pointer"
            >
              Send confirmation
            </button>
          </div>
        </.form>
      </section>

      <section class="bg-white border border-slate-200 rounded-lg shadow-sm p-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">
          {if @has_password, do: "Change password", else: "Set a password"}
        </h2>

        <.form
          for={@password_form}
          id="password_form"
          phx-submit="update_password"
          phx-change="validate_password"
          class="flex flex-col gap-4"
        >
          <%= if @has_password do %>
            <div>
              <label
                for={@password_form[:current_password].id}
                class="block text-sm font-medium text-slate-900 mb-1.5"
              >
                Current password
              </label>
              <input
                type="password"
                id={@password_form[:current_password].id}
                name={@password_form[:current_password].name}
                required
                autocomplete="current-password"
                class={[
                  "w-full bg-white rounded-md px-3 py-2 text-sm text-slate-900 placeholder-slate-400 border focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
                  if(
                    Phoenix.Component.used_input?(@password_form[:current_password]) and
                      @password_form[:current_password].errors != [],
                    do: "border-red-300",
                    else: "border-slate-300"
                  )
                ]}
              />
              <p
                :for={err <- @password_form[:current_password].errors}
                :if={Phoenix.Component.used_input?(@password_form[:current_password])}
                class="mt-1.5 text-xs text-red-700"
              >
                {CritWeb.CoreComponents.translate_error(err)}
              </p>
            </div>
          <% end %>

          <div>
            <label
              for={@password_form[:password].id}
              class="block text-sm font-medium text-slate-900 mb-1.5"
            >
              New password
            </label>
            <input
              type="password"
              id={@password_form[:password].id}
              name={@password_form[:password].name}
              required
              autocomplete="new-password"
              class={[
                "w-full bg-white rounded-md px-3 py-2 text-sm text-slate-900 placeholder-slate-400 border focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
                if(
                  Phoenix.Component.used_input?(@password_form[:password]) and
                    @password_form[:password].errors != [],
                  do: "border-red-300",
                  else: "border-slate-300"
                )
              ]}
            />
            <p
              :for={err <- @password_form[:password].errors}
              :if={Phoenix.Component.used_input?(@password_form[:password])}
              class="mt-1.5 text-xs text-red-700"
            >
              {CritWeb.CoreComponents.translate_error(err)}
            </p>
          </div>

          <div>
            <label
              for={@password_form[:password_confirmation].id}
              class="block text-sm font-medium text-slate-900 mb-1.5"
            >
              Confirm new password
            </label>
            <input
              type="password"
              id={@password_form[:password_confirmation].id}
              name={@password_form[:password_confirmation].name}
              autocomplete="new-password"
              class={[
                "w-full bg-white rounded-md px-3 py-2 text-sm text-slate-900 placeholder-slate-400 border focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
                if(
                  Phoenix.Component.used_input?(@password_form[:password_confirmation]) and
                    @password_form[:password_confirmation].errors != [],
                  do: "border-red-300",
                  else: "border-slate-300"
                )
              ]}
            />
            <p
              :for={err <- @password_form[:password_confirmation].errors}
              :if={Phoenix.Component.used_input?(@password_form[:password_confirmation])}
              class="mt-1.5 text-xs text-red-700"
            >
              {CritWeb.CoreComponents.translate_error(err)}
            </p>
          </div>

          <div>
            <button
              type="submit"
              phx-disable-with="Saving..."
              class="bg-blue-600 hover:bg-blue-700 text-white rounded-md px-4 py-2 text-sm font-medium transition cursor-pointer"
            >
              {if @has_password, do: "Update password", else: "Set password"}
            </button>
          </div>
        </.form>
      </section>
    </div>
  </main>
</div>
