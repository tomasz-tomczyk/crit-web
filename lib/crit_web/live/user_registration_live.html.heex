<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-slate-50 flex flex-col">
  <header class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <.link navigate={~p"/"} class="text-lg font-semibold text-slate-900 no-underline">
        crit
      </.link>
    </div>
  </header>

  <main class="flex-1 flex items-start justify-center py-16 px-4">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-bold text-slate-900 mb-2">Create your account</h1>
      <p class="text-sm text-slate-600 mb-6">
        Sign up with your email and a password.
      </p>

      <div class="bg-white border border-slate-200 rounded-lg shadow-sm p-6">
        <.form
          for={@form}
          id="registration_form"
          action={~p"/users/register"}
          method="post"
          phx-submit="save"
          phx-change="validate"
          phx-trigger-action={@trigger_submit}
          class="flex flex-col gap-4"
        >
          <div>
            <label
              for={@form[:email].id}
              class="block text-sm font-medium text-slate-900 mb-1.5"
            >
              Email
            </label>
            <input
              type="email"
              id={@form[:email].id}
              name={@form[:email].name}
              value={Phoenix.HTML.Form.normalize_value("email", @form[:email].value)}
              required
              autocomplete="email"
              class={[
                "w-full bg-white rounded-md px-3 py-2 text-sm text-slate-900 placeholder-slate-400 border focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
                if(Phoenix.Component.used_input?(@form[:email]) and @form[:email].errors != [],
                  do: "border-red-300",
                  else: "border-slate-300"
                )
              ]}
            />
            <p
              :for={err <- @form[:email].errors}
              :if={Phoenix.Component.used_input?(@form[:email])}
              class="mt-1.5 text-xs text-red-700"
            >
              {CritWeb.CoreComponents.translate_error(err)}
            </p>
          </div>

          <div>
            <label
              for={@form[:password].id}
              class="block text-sm font-medium text-slate-900 mb-1.5"
            >
              Password
            </label>
            <input
              type="password"
              id={@form[:password].id}
              name={@form[:password].name}
              required
              autocomplete="new-password"
              class={[
                "w-full bg-white rounded-md px-3 py-2 text-sm text-slate-900 placeholder-slate-400 border focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
                if(
                  Phoenix.Component.used_input?(@form[:password]) and
                    @form[:password].errors != [],
                  do: "border-red-300",
                  else: "border-slate-300"
                )
              ]}
            />
            <p
              :for={err <- @form[:password].errors}
              :if={Phoenix.Component.used_input?(@form[:password])}
              class="mt-1.5 text-xs text-red-700"
            >
              {CritWeb.CoreComponents.translate_error(err)}
            </p>
          </div>

          <button
            type="submit"
            phx-disable-with="Creating account..."
            class="w-full mt-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md px-4 py-2 text-sm font-medium transition cursor-pointer"
          >
            Create account
          </button>
        </.form>
      </div>

      <p class="mt-4 text-sm text-slate-600 text-center">
        Already have an account?
        <.link
          navigate={~p"/users/log_in"}
          class="font-medium text-blue-600 hover:text-blue-700 underline"
        >
          Sign in
        </.link>
      </p>
    </div>
  </main>
</div>
